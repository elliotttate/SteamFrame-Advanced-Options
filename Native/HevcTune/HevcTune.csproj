<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ProbeDll Condition="'$(ProbeDll)' == ''">../build/SteamFrameEncoderProbe.dll</ProbeDll>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../SteamLinkVRSettings/Frame/EncoderSnapshot.cs" Link="EncoderSnapshot.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/CompositorTiming.cs" Link="CompositorTiming.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/CaptureFile.cs" Link="CaptureFile.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/AdvancedEncoding.cs" Link="AdvancedEncoding.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/EncoderProbe.cs" Link="EncoderProbe.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/EncoderProbe.Av1.cs" Link="EncoderProbe.Av1.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/EncoderProbe.SendMode.cs" Link="EncoderProbe.SendMode.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/SenderDriverLayout.cs" Link="SenderDriverLayout.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/PatchManifest.cs" Link="PatchManifest.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/StreamCodecStatus.cs" Link="StreamCodecStatus.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/PairedCodecIdentity.cs" Link="PairedCodecIdentity.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/FoveationOffsets.cs" Link="FoveationOffsets.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/OpenVrSettings.cs" Link="OpenVrSettings.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/RuntimeProcessState.cs" Link="RuntimeProcessState.cs" />
    <Compile Include="../../SteamLinkVRSettings/Frame/SteamPaths.cs" Link="SteamPaths.cs" />
    <Content Include="$(ProbeDll)" Link="Native/SteamFrameEncoderProbe.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
