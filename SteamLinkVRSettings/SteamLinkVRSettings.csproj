<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.8.2</Version>
    <Title>SteamFrame Advanced Options</Title>
    <Product>SteamFrame Advanced Options</Product>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.22621.52</WindowsSdkPackageVersion>
    <RootNamespace>SteamLinkVRSettings</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NativeHelperPath>$(MSBuildThisFileDirectory)..\Native\build\SteamFrameEncoderProbe.dll</NativeHelperPath>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)..\NuGet.Config</RestoreConfigFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250513003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\bitrate-patch.json" />
    <EmbeddedResource Include="Assets\bitrate-patch-stable.json" />
    <EmbeddedResource Include="Assets\bitrate-patch-25998080.json" />
    <Content Include="$(NativeHelperPath)" Link="Native\SteamFrameEncoderProbe.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(NativeHelperPath)')" />
    <Content Include="..\Native\build\SteamFrameBenchmark.exe" Link="Native\SteamFrameBenchmark.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\Native\build\SteamFrameBenchmark.exe')" />
  </ItemGroup>
  <!-- A plain IDE/dotnet build works without the native toolchain; only encoder monitoring is unavailable. -->
  <Target Name="WarnMissingNativeHelper" BeforeTargets="Build" Condition="!Exists('$(NativeHelperPath)')">
    <Warning Text="Native\build\SteamFrameEncoderProbe.dll was not found. Run Build.ps1 or Native\build.ps1 to enable encoder monitoring." />
  </Target>
</Project>
